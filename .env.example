# Copy to .env for local work. On Railway these are set in the dashboard (docs/DEPLOY.md).
DATABASE_URL="postgresql://vijaya:vijaya@localhost:5432/vijaya?schema=public"
# 32+ random characters. Changing it signs everybody out.
SESSION_SECRET=""
APP_URL="http://localhost:3000"

# First-run users (only used when the database has no users yet).
# Passwords are optional: if left empty, strong ones are generated and printed ONCE in the log.
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@vijaya.local"
SEED_OWNER_PASSWORD=""
SEED_STOREKEEPER_NAME="Storekeeper"
SEED_STOREKEEPER_EMAIL="storekeeper@vijaya.local"
SEED_STOREKEEPER_PASSWORD=""

# Later milestones
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# AGENT_ENABLED="true"
# AGENT_DAILY_TOKENS="500000"
# DEMO_MODE="false"   # true only on a demo copy: fills in a made-up month and allows "start the demo again"
# CHROMIUM_PATH=""      # only if downloads cannot find the browser by themselves (Railway: chromium)
# UPLOAD_DIR="/data/uploads"
# SMTP_URL="smtps://user:pass@smtp.example.com:465"   # the owner is emailed about approvals and alerts; leave unset for no email
# NOTIFY_FROM="Vijaya Stores <stores@example.com>"
